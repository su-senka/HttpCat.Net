<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>

        <PackageId>HttpCat.AspNetCore</PackageId>
        <Version>1.1.0</Version>
        <Authors>su-senka</Authors>
        <Description>ASP.NET Core middleware that swaps error responses for embedded HTTP cat images without changing the status code or breaking API contracts.</Description>
        <PackageTags>aspnetcore;middleware;http;cats;errors</PackageTags>
        <RepositoryUrl>https://github.com/su-senka/HttpCat.Net</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets/**/*.jpg" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pack README and LICENSE from repository root into package root -->
        <None Include="../../README.md" Pack="true" PackagePath="\" />
        <None Include="../../LICENSE.txt" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
